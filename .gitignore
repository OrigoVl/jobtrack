# dependencies
node_modules/
*/node_modules/
.pnpm-store/

# build artefacts / coverage
coverage/
*/coverage/
*.tsbuildinfo

# env / secrets
.env
*/.env
.env.local
*/.env.local

# build output
client/dist/
server/dist/

# SQLite database (генерується автоматично)
*.db
*.db-wal
*.db-shm

# logs & OS
*.log
npm-debug.log*
.DS_Store

# editor
.vscode/
.idea/

# Playwright E2E
playwright-report/
test-results/
e2e/.tmp/*
!e2e/.tmp/.gitkeep
# Saved session (auth.setup.ts) — contains a live session token, must never be committed.
e2e/.auth/

# husky internal shims — regenerated by `pnpm install` (the prepare script), not committed
.husky/_

# Claude Code — personal/ephemeral state, never shared across machines (unlike .claude/settings.json,
# .claude/agents/, .claude/hooks/, .claude/skills/, which ARE meant to be checked in as team-shared
# config — hence the `!`-negated exceptions below; without them, `.claude/*` would silently swallow
# any NEW file added under those directories, even though older files in them are already tracked).
.claude/*
!.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
!.claude/agents/
!.claude/hooks/
!.claude/skills/
