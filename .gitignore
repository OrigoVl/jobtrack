# dependencies
node_modules/
*/node_modules/
.pnpm-store/

# build artefacts / coverage
coverage/
*/coverage/
*.tsbuildinfo

# env / secrets
.env
*/.env
.env.local
*/.env.local

# build output
client/dist/
server/dist/

# SQLite database (генерується автоматично)
*.db
*.db-wal
*.db-shm

# logs & OS
*.log
npm-debug.log*
.DS_Store

# editor
.vscode/
.idea/

# Playwright E2E
playwright-report/
test-results/
e2e/.tmp/*
!e2e/.tmp/.gitkeep
# Saved session (auth.setup.ts) — contains a live session token, must never be committed.
e2e/.auth/

# husky internal shims — regenerated by `pnpm install` (the prepare script), not committed
.husky/_
