# Скопіюй у .env і заповни за потреби.
PORT=3001

# Опційно: обмежити CORS конкретними origin через кому (напр. https://app.example.com).
# Не задано — дозволені всі origin (застосунок без auth/cookies).
# CORS_ORIGIN=

# LLM (опційно). Без ключа працює офлайн-аналіз за словником технологій.
# Провайдер: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Два рівні моделі:
#  *_MODEL       — швидка/дешева (екстракція навичок, підказки)
#  *_MODEL_SMART — сильніша (поради, оцінки співбесіди, генерація карток/задач, план)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-4-5-20250929

# Скільки мс чекати відповіді LLM-провайдера, перш ніж відмовитись (graceful offline-фолбек).
# LLM_TIMEOUT_MS      — для "smart"-рівня (складна структурована генерація, довше генерується).
# LLM_TIMEOUT_MS_FAST — для "fast"-рівня (короткі екстракції) — коротший, щоб швидше fallback'нутись
#                       на офлайн-евристику, якщо провайдер незвично завис на простому запиті.
LLM_TIMEOUT_MS=30000
LLM_TIMEOUT_MS_FAST=15000

# Вмикай, ЛИШЕ якщо застосунок стоїть за reverse-proxy/LB (nginx, Cloudflare тощо) —
# інакше req.ip і rate-limit бачитимуть IP проксі, а не клієнта.
# "false" (дефолт) | "true" | число хопів (напр. "1") | "loopback"
TRUST_PROXY=false
