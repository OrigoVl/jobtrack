# Copy to .env and fill in as needed.
PORT=3001

# Postgres connection string. Defaults to the `postgres` service in docker-compose.yml if unset —
# required in production (NODE_ENV=production).
# DATABASE_URL=postgres://jobtrack:jobtrack@localhost:5432/jobtrack
# DB_POOL_MAX=10
# DB_MIGRATE_ON_BOOT=true

# Optional: restrict CORS to specific origins, comma-separated (e.g. https://app.example.com).
# Only needed if the client is served from a different origin than the API (in dev, Vite proxies
# /api to this server, so they're same-origin; in prod, this server serves the client build itself).
# CORS_ORIGIN=

# better-auth. BETTER_AUTH_SECRET is required in production (signs/encrypts session cookies) —
# generate one with `openssl rand -base64 32`. BETTER_AUTH_URL defaults to http://localhost:PORT.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=

# Resend (optional) — without a key, verification/reset-password emails are logged instead of
# sent, so local dev needs no email provider at all.
# RESEND_API_KEY=
# EMAIL_FROM=JobTrack <onboarding@resend.dev>

# Google OAuth (optional) — both or neither. Without them, only email+password login is offered.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth (optional) — both or neither, same graceful degradation as Google above (the
# "Continue with LinkedIn" button is hidden if unset). The LinkedIn app must have the "Sign In
# with LinkedIn using OpenID Connect" product enabled. Register this OAuth redirect/callback URL
# in the LinkedIn app: ${BETTER_AUTH_URL}/api/auth/callback/linkedin
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Contact enrichment (optional, all separately optional) — recruiter/hiring-contact lookups
# (modules/contacts/enrichment/) against paid third-party people-data APIs. These are OPERATOR-
# HELD keys (one key for the whole app, not per-user "bring your own key") — a deliberate product
# choice made after flagging the ToS/redistribution risk to the product owner (Hunter/Apollo/Snov
# license their data to the key holder; re-serving it to jobtrack's own end users under one shared
# key is a legal grey area, especially for Apollo/Snov — revisit if a provider starts enforcing
# this). Without ANY of these set, the feature still works: it degrades to a keyless email-pattern
# guess (first.last@domain, etc.) plus a LinkedIn people-search deep link.
# HUNTER_API_KEY=
# APOLLO_API_KEY=
# Snov.io uses OAuth2 client-credentials — both or neither.
# SNOV_CLIENT_ID=
# SNOV_CLIENT_SECRET=
# Daily cap per user (UTC calendar day) on paid enrichment lookups — 0 disables it. Once hit,
# further enrichment calls that day skip the keyed providers and fall back to the keyless guess.
CONTACT_ENRICH_DAILY_LOOKUPS=25

# LLM (optional). Without a key, offline dictionary-based analysis is used instead.
# Provider: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Two model tiers:
#  *_MODEL       — fast/cheap (skill extraction, hints)
#  *_MODEL_SMART — stronger (advice, interview scoring, card/drill generation, plans)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-5
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-5

# How long (ms) to wait for the LLM provider before giving up (graceful offline fallback).
# LLM_TIMEOUT_MS      — for the "smart" tier (complex structured generation, takes longer).
# LLM_TIMEOUT_MS_FAST — for the "fast" tier (short extractions) — shorter, so a provider that's
#                       unusually stuck on a simple request falls back to the offline heuristic sooner.
LLM_TIMEOUT_MS=30000
LLM_TIMEOUT_MS_FAST=15000

# Soft per-user daily spend cap in USD (estimated from token usage) — 0 (default) disables it.
# Once a user crosses this within a UTC day, further AI calls fall back to the offline heuristic
# for the rest of that day instead of calling the provider again.
LLM_DAILY_COST_CAP_USD=0

# Stripe (optional, all three or none). Not set — the billing module is inert: no plan/pricing UI,
# no AI quota enforcement, aiLimiter stays at its flat default. Test-mode keys are fine for dev;
# use `stripe listen --forward-to localhost:3001/api/billing/webhook` to receive webhooks locally.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=

# Free-tier AI quota, in billable calls per UTC calendar month (not USD — see env.ts's comment on
# why a dollar figure would be gameable by model choice).
BILLING_FREE_AI_CALLS_PER_MONTH=20

# Pro-tier fair-use ceiling, in USD/month — an operator safety valve so a single power-user
# account can't push per-seat margin negative; distinct from LLM_DAILY_COST_CAP_USD below, which
# applies to every account regardless of plan.
BILLING_PRO_MONTHLY_COST_CEILING_USD=5

# Enable ONLY if the app sits behind a reverse proxy/LB (nginx, Cloudflare, etc.) — otherwise
# req.ip and rate-limit would see the proxy's IP, not the client's.
# "false" (default) | "true" | a hop count (e.g. "1") | "loopback"
TRUST_PROXY=false

# Sentry (optional). Not set — error tracking is disabled, the app keeps logging only via pino.
# SENTRY_DSN=
# APP_VERSION=

# Link shown on the admin panel's "Logs & Errors" page (e.g. your Sentry project's issues URL).
# LOGS_DASHBOARD_URL=

# Telegram (optional, both or neither). Not set — account linking is hidden and the digest/
# saved-searches schedulers only notify by email. Create a bot via @BotFather to get a token;
# after deploying, register the webhook once: node server/scripts/set-telegram-webhook.mjs
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Optional shared secret, checked on every incoming webhook call — generate one (e.g.
# `openssl rand -hex 32`) and set it here BEFORE running set-telegram-webhook.mjs, so the script
# registers it with Telegram at the same time.
# TELEGRAM_WEBHOOK_SECRET=

# Redis (optional). Not set — rate limiting keeps counters in this process's own memory, correct
# for a single instance. Required once you run more than one replica behind a load balancer.
# REDIS_URL=redis://localhost:6379
